package com.vijaykumar.portfolio.service.email;

/**
 * Contract for any transactional email provider.
 *
 * Implementations must be thread-safe and idempotent.
 * The orchestrator handles retry, fallback, and deduplication.
 */
public interface EmailProvider {

    /**
     * Human-readable provider name for logging.
     */
    String name();

    /**
     * Send a transactional email.
     *
     * @param to      recipient address
     * @param subject email subject
     * @param text    plain-text body
     * @param html    HTML body (may be null)
     * @return true if the provider accepted the request (2xx)
     * @throws Exception on any failure — the orchestrator will catch and fallback
     */
    boolean send(String to, String subject, String text, String html) throws Exception;
}
